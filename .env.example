# ==========================================
# Django Security & Environment Settings
# ==========================================
SECRET_KEY=change-me-to-a-super-secret-random-50-character-key-in-production-12345
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,.railway.app,.up.railway.app
CSRF_TRUSTED_ORIGINS=https://*.railway.app,https://*.up.railway.app

# ==========================================
# Database Configuration
# ==========================================
# Railway sets DATABASE_URL automatically when you add a PostgreSQL database plugin!
# DATABASE_URL=postgresql://postgres:password@roundhouse.proxy.rlwy.net:12345/railway

# Fallback SQLite (for local testing):
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3

# ==========================================
# Superadmin Initial Credentials
# ==========================================
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_EMAIL=admin@cardcraft.pro
SUPERADMIN_PASSWORD=Admin@123456

# ==========================================
# Brand & Application Metadata
# ==========================================
APP_NAME=Organization ID Card Management System
APP_VERSION=1.0.0
APP_DESIGNER_NAME=Tulasi Nepali
APP_DESIGNER_ROLE=Full Stack Engineer
APP_CONTACT_PHONE=+977-9800000000
APP_CONTACT_EMAIL=info@cardcraft.pro
APP_WEBSITE=https://cardcraft.pro
APP_COPYRIGHT_YEAR=2026

# ==========================================
# Media & Static Storage
# ==========================================
MEDIA_URL=/media/
STATIC_URL=/static/
